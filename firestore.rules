rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 배경 ─────────────────────────────────────────────────────────────
    // Letter Go 는 자체 OTP 인증(이메일/SMS) + Firestore 용 anonymous Firebase
    // Auth 를 사용한다. 그래서 `request.auth.uid` 가 매번 바뀌는 1회용
    // 식별자라서 Firestore rule 로 owner-only check 가 직접적으로 작동하지
    // 않는다. (향후 Phone/Email Auth 마이그레이션 시 uid 기반으로 강화 가능.)
    //
    // 보안 모델 (Build 207 강화):
    //   - read/list 는 지도 동기화·편지 픽업을 위해 누구나 허용.
    //   - create 는 isSignedIn() + 핵심 필드 검증 (익명 편지 enforcement,
    //     content 크기 한도, 필드 화이트리스트).
    //   - update 는 시스템 카운터 / 도착 상태 필드만 변경 허용. 본문·발신자
    //     ID·이름·발송시각은 변경 불가.
    //   - delete 는 모두 차단. 실제 삭제는 관리자 API key REST 만 가능.
    //   - reports 는 create 만, 읽기·수정·삭제 차단 (관리자 REST 전용).
    //
    // 클라이언트는 letter 본문이 공개 데이터인 줄 알고 사용해야 한다 — 즉,
    // 본문에는 사용자가 의도적으로 공유하기로 한 텍스트만 들어간다. 이미지·
    // 쿠폰 코드도 마찬가지. 민감 PII(전화번호·이메일)는 letter 본문에
    // 저장되지 않는다 (compose 화면이 검증).

    function isSignedIn() {
      return request.auth != null;
    }

    // Build 303 (MED audit): public-read collection 의 list query 한도 cap.
    // 사용자가 unbounded list 로 read 폭증 시도 차단 (cost protection).
    function reasonableListLimit() {
      return request.query.limit <= 100;
    }

    // 익명 편지가 정말 익명인지 검증.
    //   senderId  → "anon_" prefix (per-letter unique, 역추적 불가)
    //   senderName → 고정 sentinel '__anonymous__' (UI 가 i18n 으로 치환)
    function isAnonLetterValid(data) {
      return data.isAnonymous == false
          || (data.senderName == '__anonymous__'
              && data.senderId is string
              && data.senderId.matches('^anon_.+'));
    }

    // 편지 생성 시 검증 — 본문 크기 + 익명 enforcement.
    // Build 300 (P0 audit): 초기 counter seeding 차단 (likeCount/ratingTotal/
    // reportCount 등을 큰 값으로 시드해 fake popularity 노출하던 표면 닫음).
    function isValidLetterCreate(data) {
      return data.content is string
          && data.content.size() <= 5000
          && data.senderId is string
          && data.senderName is string
          && data.senderName.size() <= 100
          && data.isAnonymous is bool
          && isAnonLetterValid(data)
          && (!('likeCount' in data) || data.likeCount == 0)
          && (!('ratingTotal' in data) || data.ratingTotal == 0)
          && (!('ratingCount' in data) || data.ratingCount == 0)
          && (!('reportCount' in data) || data.reportCount == 0)
          && (!('pickupCount' in data) || data.pickupCount == 0)
          && (!('readCount' in data) || data.readCount == 0)
          && (!('redeemedCount' in data) || data.redeemedCount == 0);
    }

    // update 로 변경 가능한 필드 화이트리스트 — 카운터 + 도착 상태만.
    // 본문 / 발신자 / 좌표 / 카테고리 / 쿠폰 정보는 create 후 immutable.
    // Build 335 (PR-S7): redemption 코드 흐름 — revealedCount + codeRevealedAt
    //   화이트리스트 추가. startRedemption 의 atomic increment + timestamp 가
    //   기존 rule 에선 silent reject 되어 Brand 4단계 funnel 측정 불가했음.
    //   redeemedAt 타임스탬프도 markLetterRedeemed 에서 PATCH 하므로 같이.
    function isAllowedLetterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'pickupCount', 'redeemedCount', 'revealedCount', 'readCount',
            'likeCount', 'ratingTotal', 'ratingCount',
            'status', 'arrivedAt', 'readAt', 'isReadByRecipient',
            'reportCount',
            'codeRevealedAt', 'redeemedAt',
          ]);
    }

    // Build 297 (HIGH security audit): 카운터 변경 폭 검증.
    // 화이트리스트만으로는 누구나 likeCount 를 +999 시키는 review-bombing
    // 가능했음. 단일 호출에서 +1/-1/0 만 허용 (카운터 자연 증가) + 음수 차단.
    // Build 335 (PR-S7): revealedCount 도 동일 패턴.
    function _delta(field) {
      return (field in request.resource.data ? request.resource.data[field] : 0)
           - (field in resource.data ? resource.data[field] : 0);
    }
    function isReasonableLetterCounterDelta() {
      return _delta('pickupCount') >= 0 && _delta('pickupCount') <= 1
          && _delta('redeemedCount') >= 0 && _delta('redeemedCount') <= 1
          && _delta('revealedCount') >= 0 && _delta('revealedCount') <= 1
          && _delta('readCount') >= 0 && _delta('readCount') <= 1
          && _delta('likeCount') >= -1 && _delta('likeCount') <= 1
          && _delta('ratingTotal') >= 0 && _delta('ratingTotal') <= 5
          && _delta('ratingCount') >= 0 && _delta('ratingCount') <= 1
          && _delta('reportCount') >= 0 && _delta('reportCount') <= 1;
    }

    // ── users 컬렉션 ──────────────────────────────────────────────────
    // Build 297 (P0 security audit): update/delete 를 isSignedIn() 만으로 허용
    // 하면 어떤 인증 사용자든 다른 사용자 doc 을 덮어쓰거나 삭제 (PII 변조 +
    // banned=false self-reset + admin doc 파괴 가능). 익명 Firebase Auth 라
    // owner check 직접 불가하므로 update 는 사용자가 self-mutable 한 필드만
    // 화이트리스트로 허용. delete 는 admin REST 전용으로 차단.
    function isAllowedUserUpdate() {
      // banned / isPremium / isBrand / id 등 moderation/tier 필드는 클라이언트
      // 가 변경 불가. 사용자 self-edit 가능한 프로필/카운터/동의만 허용.
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'username', 'country', 'countryFlag',
            'latitude', 'longitude',
            'lastKnownLatitude', 'lastKnownLongitude',
            'isUsernamePublic', 'isMapPublic',
            'lastSeenAt', 'loggedOutAt', 'updatedAt',
            'receivedCount', 'replyCount', 'sentCount', 'likeCount',
            'inviteCode', 'inviteRewardCredits', 'inviteAppliedCode',
            'inviteRewardAt',
            'brandExtraMonthlyQuota', 'brandExactDropCredits',
            'customTowerName', 'towerColor', 'towerAccentEmoji',
            'towerRoofStyle', 'towerWindowStyle',
            'preferredCategoryKey',
            // Build 414 (sim100 P0-1): 클라이언트 _doSaveUserToFirestore PATCH 가
            //   항상 포함하던 필드. 화이트리스트에 없어 update 가 atomic 403 →
            //   프로필/카운터/위치/크레딧 전부 서버 미저장(런타임 확인). 추가.
            //   - pickedUpCampaignIds: 본인 픽업 dedup 동기화(Build 324) — self 데이터.
            //   - isBrand/brandName: 계정종류 영속(Build 406). create 는 여전히
            //     isValidUserCreate 가 isBrand=false 강제(가입 시 self-born Brand 차단).
            //     ⚠️ update 에서 client 가 isBrand=true 설정 가능 = self-promote
            //     잔존 위험. 단, 본 앱은 anon-auth 라 Brand 가 이미 client-side 티어
            //     (서버 결제검증 부재, 백로그 ③/#33). 근본 차단은 Auth Phase 3
            //     cutover + 서버 entitlement 검증 (firestore.rules.phase2).
            'pickedUpCampaignIds', 'isBrand', 'brandName', 'id',
            // Build 413 (Auth Phase 2): authUid 바인딩 필드 허용. 이게 없으면
            //   AUTH_BIND_ENABLED 빌드에서 user doc 저장이 hasOnly 위반으로 전부
            //   403 거부됨(시뮬레이터 테스트로 확인). 추가형 변경 — 다른 제약·
            //   read 규칙 불변, 프로덕션(flag OFF, authUid 미기록) 영향 없음.
            //   Phase 3 cutover 에서 authUid 는 owner-check 기준이 됨.
            'authUid',
            // Build 300: welcomeTrialClaimedAt 는 client update 차단.
            // 서버측 source of truth = trial_claims/{sha256(email)}.
            // (client 가 user doc 의 timestamp 를 지워 farming 시도 회로 차단.)
          ]);
    }

    function isValidUserCreate(data) {
      // create 시점에 banned/tier/admin self-allowlist 차단.
      // Build 300 (P0 audit): isPremium/isBrand/isAdmin/roles 도 강제 false/없음.
      return (!('banned' in data) || data.banned == false)
          && (!('isPremium' in data) || data.isPremium == false)
          && (!('isBrand' in data) || data.isBrand == false)
          && (!('isAdmin' in data) || data.isAdmin == false)
          && !('roles' in data);
    }

    // Build 300 (P0 audit): user doc 의 credit 카운터 self-mint 차단.
    // 사용자가 본인 doc 의 brandExactDropCredits/inviteRewardCredits/
    // brandExtraMonthlyQuota 를 9999 로 patch 해 결제 우회하던 표면 닫음.
    // grant 는 admin REST (또는 Cloud Function) 전용. consume 만 client-side.
    function isReasonableUserCounterDelta() {
      let curEx = ('brandExactDropCredits' in resource.data
                   ? resource.data.brandExactDropCredits : 0);
      let newEx = ('brandExactDropCredits' in request.resource.data
                   ? request.resource.data.brandExactDropCredits : 0);
      let curIn = ('inviteRewardCredits' in resource.data
                   ? resource.data.inviteRewardCredits : 0);
      let newIn = ('inviteRewardCredits' in request.resource.data
                   ? request.resource.data.inviteRewardCredits : 0);
      let curBQ = ('brandExtraMonthlyQuota' in resource.data
                   ? resource.data.brandExtraMonthlyQuota : 0);
      let newBQ = ('brandExtraMonthlyQuota' in request.resource.data
                   ? request.resource.data.brandExtraMonthlyQuota : 0);
      // 모든 credit 카운터는 client 측에서 감소만 허용 (consume).
      // 증가는 admin REST.
      return newEx <= curEx && newIn <= curIn && newBQ <= curBQ;
    }

    match /users/{userId} {
      // 현 상태의 PII 보호 layer:
      //   - 클라이언트가 `mask.fieldPaths=...` 로 공개 필드만 요청
      //     (latitude/longitude/countryFlag/username/카운터 — phone/email 제외)
      //   - latitude/longitude 는 ~110m 정밀도로 round 후 저장
      //   - 클라이언트 코드가 `isMapPublic=false` 인 사용자를 즉시 skip
      // Build 303: list 호출 시 pageSize ≤ 100 강제 (cost protection).
      allow read: if true;
      allow list: if reasonableListLimit();

      allow create: if isSignedIn() && isValidUserCreate(request.resource.data);
      // banned/isPremium/isBrand 변경 차단 — 모더레이션/티어는 admin REST 전용.
      // Build 300: credit counter 도 client 가 self-mint 차단 (consume 만 허용).
      allow update: if isSignedIn()
                  && isAllowedUserUpdate()
                  && isReasonableUserCounterDelta();

      // 회원 탈퇴는 클라이언트가 직접 호출. owner check 불가하지만 1회 호출
      // 후 prefs 가 비워지고 secure storage 도 wipe 되므로 abuse 표면 작음.
      // Build 384 (PR-FF3 audit A14): doc id 형식 검증 추가 — random
      //   UUID/hex/base32 형식 (16-64 char) 만 통과. 일반 attacker 가
      //   sequential id enumerate 로 삭제 시도 차단. 진짜 owner check 는
      //   Phase 2 Cloud Function 이전 deferred.
      allow delete: if isSignedIn()
                  && userId.matches('^[a-zA-Z0-9_-]{16,64}$');
    }

    // ── letters 컬렉션 ────────────────────────────────────────────────
    match /letters/{letterId} {
      // map 동기화·픽업을 위해 누구나 read/list. (본문은 사용자가 공개를
      // 전제로 작성한다는 정책.)
      // Build 303: list pageSize ≤ 100 (cost protection).
      // Build 335 (PR-S7 TODO Phase 2): redemptionCode 가 본 doc 에 평문 저장됨
      //   → public read 시 누구나 읽기 가능. anonymous Firebase Auth 환경에선
      //   owner-check 가 불가능해 Phase 1 에선 수용. Phase 2 (proper auth)
      //   에서 redemptionCode 를 subcollection 분리 후 sender_only read 룰로
      //   제한 예정. 현 단계 mitigation: 픽업 안한 사용자가 코드 알아도 매장
      //   에서 사용 시 IDOR 가드 (PR-S6) 가 자기 디바이스 reveal 차단.
      allow read: if true;
      allow list: if reasonableListLimit();

      // create 시 본문 크기·익명 enforcement 검증.
      allow create: if isSignedIn() && isValidLetterCreate(request.resource.data);

      // update 는 카운터·상태 필드만. 본문/발신자/좌표/카테고리는 immutable.
      // Build 297: 카운터 폭 검증 추가 (review-bombing 차단).
      allow update: if isSignedIn()
                  && isAllowedLetterUpdate()
                  && isReasonableLetterCounterDelta();

      // delete 차단 — admin REST 만 가능.
      allow delete: if false;
    }

    // ── reports 컬렉션 (편지 신고 기록) ─────────────────────────────────
    match /reports/{reportId} {
      // 인증된 사용자는 신고 생성 가능. 읽기·수정·삭제는 관리자 REST 만.
      allow create: if isSignedIn();
      allow read, list, update, delete: if false;
    }

    // ── merchant_interest 컬렉션 (Build 415 — B2B 영업 리드) ─────────────
    // "사장님이세요?" 시트에서 관심 등록 시 기록되는 운영자 전용 리드.
    // 이전엔 룰이 없어 default-deny(catch-all)로 모든 write 가 403 → 리드 소실.
    // reports 와 동일 정책: 인증 사용자 create-only, 읽기·수정·삭제는 admin REST.
    match /merchant_interest/{interestId} {
      allow create: if isSignedIn()
          && request.resource.data.userId is string
          && request.resource.data.country is string;
      allow read, list, update, delete: if false;
    }

    // ── brand_zones 컬렉션 (Build 283 — Brand auto-drop) ───────────────
    // Brand 사용자가 미리 설정한 "쿠폰 zone": 좌표 + 반경 + 쿠폰 내용. 일반
    // 사용자가 zone 반경 안에 들어오면 자동으로 letter 1통이 인박스에 도착.
    //
    // 보안 모델 (anonymous Firebase Auth 한계):
    //   - read/list 는 누구나 — 클라이언트가 가까운 zone 쿼리해야 함. 본문
    //     은 brand 가 의도적으로 공개하는 쿠폰 정보 (PII 없음).
    //   - create 는 isSignedIn() + 본문 크기 + brandId 비어있지 않음.
    //     실제 brand verified 검증은 client-side + Phase 2 의 Cloud Function
    //     server-side re-verify 로 강화 예정 (anonymous auth 이므로 본 rule
    //     에서 직접 owner-check 불가).
    //   - update 는 redeemedCount 만 (counter increment) — 본문/좌표/반경/
    //     시간은 immutable.
    //   - delete 차단 — admin REST + 만료된 zone 일괄 정리 (별도 cron 또는
    //     Cloud Function).

    function isValidBrandZoneCreate(data) {
      // Build 364 (PR-BB3 hardening): 필드 화이트리스트 + redemptionCode 검증.
      // Build 371 (PR-CC5 P0 #18 #19): center 좌표 [-90,90]/[-180,180] 범위 +
      //   ISO8601 형식 검증. 이전엔 `data.center.lat = "DROP TABLE"` string 도
      //   통과 (cache miss 후 client crash) + 좌표 99.99/179.99 spam zone +
      //   "9999-12-31" 영구 zone 가능 → read cap 점유 amplification.
      return data.keys().hasOnly([
            'brandId', 'brandName', 'content', 'redemptionInfo',
            'redemptionCode', 'center', 'radiusM', 'startsAt', 'expiresAt',
            'maxRedeems', 'redeemedCount', 'createdAt', 'id'
          ])
          && data.brandId is string && data.brandId.size() > 0 && data.brandId.size() <= 64
          // Build 393 (PR-HH2 P0): brandId 형식 검증 — 'admin' literal 단 1개
          //   (admin 본인 zone) 또는 UUID 형식 (일반 brand). 임의 string 차단.
          //   주: anonymous Auth 한계로 admin 사칭 100% 차단 불가 (Phase 2
          //   Cloud Function 까지 stop-gap) — client-side 의 admin email
          //   가드 (admin_special_message_screen) 와 함께 layered defense.
          && (data.brandId == 'admin' || data.brandId.matches('^[a-zA-Z0-9_-]{16,64}$'))
          && data.brandName is string && data.brandName.size() <= 100
          && data.content is string && data.content.size() <= 1000
          && (!('redemptionInfo' in data)
              || (data.redemptionInfo is string && data.redemptionInfo.size() <= 500))
          && (!('redemptionCode' in data)
              || (data.redemptionCode is string
                  && data.redemptionCode.size() >= 6
                  && data.redemptionCode.size() <= 16
                  && data.redemptionCode.matches('^[0-9A-Z]+$')))
          // center mapValue: {lat: double, lng: double} — 위·경도 범위 검증.
          && data.center is map
          && data.center.lat is number
          && data.center.lat >= -90.0 && data.center.lat <= 90.0
          && data.center.lng is number
          && data.center.lng >= -180.0 && data.center.lng <= 180.0
          && data.radiusM is number
          && data.radiusM >= 50.0 && data.radiusM <= 5000.0
          && data.startsAt is string
          && data.startsAt.size() >= 20 && data.startsAt.size() <= 32
          && data.expiresAt is string
          && data.expiresAt.size() >= 20 && data.expiresAt.size() <= 32
          && data.maxRedeems is number
          && data.maxRedeems >= 0 && data.maxRedeems <= 100000;
    }

    function isAllowedBrandZoneUpdate() {
      // redeemedCount 만 변경 가능. counter increment 흐름.
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['redeemedCount']);
    }

    // Build 297 (HIGH security audit): redeemedCount 증분 0 또는 +1 만 허용.
    // quota fake-exhaustion 공격 차단.
    function isReasonableBrandZoneCounterDelta() {
      return _delta('redeemedCount') >= 0 && _delta('redeemedCount') <= 1;
    }

    match /brand_zones/{zoneId} {
      // Build 303: list cap (cost protection).
      allow read: if true;
      allow list: if reasonableListLimit();
      allow create: if isSignedIn() && isValidBrandZoneCreate(request.resource.data);
      allow update: if isSignedIn()
                  && isAllowedBrandZoneUpdate()
                  && isReasonableBrandZoneCounterDelta();
      allow delete: if false;
    }

    // ── trial_claims (Build 299) — Welcome trial 1회 farming 차단 ─────
    // sha256(email) 을 doc id 로. 사용자가 계정 삭제 후 재가입 (동일 이메일) →
    // claim doc 그대로 존재 → 재부여 차단.
    // Build 300 (P0 audit):
    //   - list:false — email-hash 집합 enumerate 차단 (rainbow-table privacy).
    //     point-read (get) 만 허용 — 자기 hash 단건 조회 가능.
    //   - create 시 hasOnly(['claimedAt']) + claimedAt 길이 cap — bloat 차단.
    //   - 사용자가 victim 이메일 hash 를 pre-create 해 trial 차단하던 griefing
    //     은 owner check 불가 (anonymous Firebase Auth) 라서 100% 막을 수 없음.
    //     완화: hash 가 random sha256 (64-hex) 패턴인 경우만 허용 + 후속 단계
    //     에서 admin REST 기반 issuance 로 마이그레이션 (Cloud Function).
    match /trial_claims/{emailHash} {
      // Build 412 (PII sim MED): get:true → false. sha256(email) point-read 이
      //   email 등록여부 membership oracle (rainbow-table) 로 악용 가능했음.
      //   클라이언트는 read 불필요 — create 의 currentDocument.exists=false
      //   precondition 이 단건 grant 를 server-side 로 보장 (tryClaimWelcomeTrial
      //   의 alreadyExists 처리로 검증됨). list 는 이미 false.
      allow get: if false;
      allow list: if false;
      // Build 370 (PR-CC4 P0 #10 stop-gap): createdBy 필드 추적 추가.
      //   victim email hash 를 attacker 가 pre-create 한 griefing 케이스를
      //   admin REST 로 사후 식별 가능. anonymous Firebase Auth 한계로 client
      //   create 자체는 막을 수 없음 — Cloud Function 마이그레이션까지의 stop-gap.
      allow create: if isSignedIn()
                  && emailHash.matches('^[a-f0-9]{64}$')
                  && request.resource.data.keys().hasOnly(['claimedAt', 'createdBy'])
                  && request.resource.data.claimedAt is string
                  && request.resource.data.claimedAt.size() < 64
                  && request.resource.data.createdBy is string
                  && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ── 기타 경로는 모두 차단 ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
